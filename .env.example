# .env.example
# Plantilla de variables de entorno para estudiantes de Code Andes Academy
# Copia este archivo como .env en la raiz de tu proyecto andesmobile-app-avance

# 1. SERVICIOS CLOUD DE BACKEND (SUPABASE)
EXPO_PUBLIC_SUPABASE_URL=https://[TU_ID_PROYECTO].supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=[TU_ANON_PUBLIC_KEY]

# 2. CONFIGURACION DE YAPE (BILLETERA P2P BCP - DATOS DEMO)
EXPO_PUBLIC_YAPE_NUMERO="987 654 321"
EXPO_PUBLIC_YAPE_TITULAR="Code Andes Academy S.A.C."
EXPO_PUBLIC_YAPE_BANCO="Banco de Credito del Peru (BCP)"

# 3. CONFIGURACION DE PLIN (BILLETERA P2P BBVA / INTERBANK - DATOS DEMO)
EXPO_PUBLIC_PLIN_NUMERO="987 654 321"
EXPO_PUBLIC_PLIN_TITULAR="Code Andes Academy S.A.C."
EXPO_PUBLIC_PLIN_BANCO="BBVA / Interbank"

# 4. CONFIGURACION DE TRANSFERENCIAS Y TARJETAS BANCARIAS
EXPO_PUBLIC_TARJETA_CUENTA="193-9821049-0-44"
EXPO_PUBLIC_TARJETA_TITULAR="Code Andes Academy S.A.C."
EXPO_PUBLIC_TARJETA_BANCO="BCP Cta. Cte. Soles"
EXPO_PUBLIC_CCI_DESTINO="002-193009821049044-12"

# 5. CONFIGURACION DE PASARELA CORPORATIVA (CULQI / YAPE API)
# Modo de operacion: "p2p" (QR oficial + Vouchers) o "api" (Pasarela automatizada Culqi)
EXPO_PUBLIC_PASARELA_MODO="p2p"

# Llave Publica Culqi (Para tokenizacion en cliente - Inicia con pk_test_ o pk_live_)
# NOTA DE CIBERSEGURIDAD: La llave privada (sk_...) NUNCA va en la app; reside en Supabase Edge Functions
EXPO_PUBLIC_CULQI_PUBLIC_KEY="pk_test_b8e5c32789123456"
